{
    "name": "int_algolia_sfra",
    "version": "26.6.0",
    "description": "Algolia SFRA Link Cartridge",
    "scripts": {
        "test": "npm run test:unit",
        "test:unit": "jest --testPathPatterns test/unit",
        "test:e2e": "node --experimental-vm-modules scripts/e2eTest.js",
        "copy-scripts": "copy-files-from-to",
        "lint:js": "eslint .",
        "uploadCartridge": "b2c code deploy -c int_algolia -c int_algolia_controllers -c int_algolia_sfra -c algolia_sg_changes -c bm_algolia",
        "watch": "b2c code watch -c int_algolia -c int_algolia_controllers -c int_algolia_sfra -c algolia_sg_changes -c bm_algolia",
        "test:frontend": "cypress run --browser chrome",
        "deploy:code": "node scripts/deployCode.js",
        "import:preferences": "node scripts/importPreferences.js",
        "run:sfcc-job": "node scripts/runSFCCJob.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/algolia/algoliasearch-sfcc-b2c.git"
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "devDependencies": {
        "@algolia/autocomplete-js": "1.17.9",
        "@algolia/autocomplete-theme-classic": "1.17.9",
        "@algolia/recommend": "4.24.0",
        "@algolia/recommend-js": "1.14.0",
        "@eslint/js": "10.0.1",
        "@salesforce/b2c-cli": "^2.9.0",
        "@salesforce/b2c-tooling-sdk": "^2.9.0",
        "@slack/web-api": "^8.2.0",
        "algoliasearch": "^5.60.0",
        "copy-files-from-to": "^4.0.1",
        "cypress": "^16.2.0",
        "eslint": "10.13.0",
        "eslint-plugin-cypress": "^7.0.2",
        "eslint-plugin-jsdoc": "65.4.2",
        "globals": "17.13.0",
        "instantsearch.css": "8.5.1",
        "instantsearch.js": "4.77.1",
        "jest": "30.5.2",
        "prettier": "3.9.10",
        "search-insights": "2.17.3"
    },
    "allowScripts": {
        "cypress": true,
        "@parcel/watcher": false,
        "protobufjs": false,
        "unrs-resolver": false,
        "yarn": false
    }
}
